# Bootstrap profile cloud.demo — independent demonstration deployment, isolated from dev/test/staging/prod.
SDKWORK_MESSAGING_DEPLOYMENT_PROFILE=cloud
SDKWORK_MESSAGING_ENVIRONMENT=demo
SDKWORK_MESSAGING_PROFILE_ID=cloud.demo
SDKWORK_MESSAGING_APPLICATION_PUBLIC_HTTP_URL=https://messaging-demo.sdkwork.com
SDKWORK_MESSAGING_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MESSAGING_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
