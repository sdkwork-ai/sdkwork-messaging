{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-messaging",
  "applicationCode": "messaging",
  "archetype": "client-application",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": { "allowed": ["standalone", "cloud"] },
    "environment": { "allowed": ["development", "test", "staging", "production"] }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_MESSAGING_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_MESSAGING_ENVIRONMENT",
    "profileId": "SDKWORK_MESSAGING_PROFILE_ID",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_MESSAGING_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_MESSAGING_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": ["http"],
      "httpUrlEnv": "SDKWORK_MESSAGING_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_MESSAGING_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": ["http"],
      "httpUrlEnv": "SDKWORK_MESSAGING_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_MESSAGING_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": { "httpHost": "messaging.sdkwork.com" },
    "platform.api-gateway": { "httpHost": "api.sdkwork.com" }
  },
  "orchestration": {
    "profiles": {
      "cloud.development": {
        "processes": [
          {
            "id": "messaging-pc-browser",
            "role": "client",
            "script": "dev:cloud",
            "applicationRoot": "apps/sdkwork-messaging-pc",
            "runtimeTargets": ["browser"],
            "clientArchitectures": ["pc-web"],
            "required": true
          }
        ],
        "healthSurfaces": ["application.public-ingress", "platform.api-gateway"]
      },
      "standalone.test": { "processes": [], "healthSurfaces": ["application.public-ingress"] },
      "standalone.staging": { "processes": [], "healthSurfaces": ["application.public-ingress"] },
      "standalone.production": { "processes": [], "healthSurfaces": ["application.public-ingress"] },
      "cloud.test": { "processes": [], "healthSurfaces": ["application.public-ingress", "platform.api-gateway"] },
      "cloud.staging": { "processes": [], "healthSurfaces": ["application.public-ingress", "platform.api-gateway"] },
      "cloud.production": { "processes": [], "healthSurfaces": ["application.public-ingress", "platform.api-gateway"] }
    }
  }
}
